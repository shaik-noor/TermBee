{
  "name": "termbee",
  "private": true,
  "version": "0.1.0",
  "description": "TermBee — a fast, friendly SSH terminal for Windows and macOS",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "icons": "tauri icon assets/brand/termbee-icon.svg",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
