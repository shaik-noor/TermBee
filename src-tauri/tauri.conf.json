{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermBee",
  "version": "../package.json",
  "identifier": "app.termbee.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TermBee",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#15110B"
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "A fast, friendly SSH terminal",
    "longDescription": "TermBee keeps every server you work on in one hive: saved hosts, tabbed SSH terminals, keychain-backed logins and host-key checks, on Windows and macOS.",
    "copyright": "© 2026 Shaik Noor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
