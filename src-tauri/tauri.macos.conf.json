{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TermBee",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#15110B",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 16 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
