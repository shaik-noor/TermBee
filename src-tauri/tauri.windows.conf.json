{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TermBee",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#15110B",
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
